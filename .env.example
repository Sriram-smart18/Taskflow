# Backend Environment Variables
# Create a .env file inside the /server directory

# Node Environment
NODE_ENV=development

# Application Port
PORT=5000

# Database Connection URL (PostgreSQL for Production, SQLite for Local Dev)
DATABASE_URL="file:./dev.db"
# Example for Postgres: DATABASE_URL="postgresql://user:password@localhost:5432/taskflow?schema=public"

# JWT Secret Key
JWT_SECRET="your-super-secret-jwt-key"
