# TaskFlow Environment Variables
# Rename this file to .env and fill in the values before running the application

# 1. Database Configuration
# Provide a standard PostgreSQL connection string.
# Railway provides this automatically in the variables tab as `DATABASE_URL`.
DATABASE_URL="postgresql://user:password@localhost:5432/taskflow?schema=public"

# 2. Authentication
# Replace this with a strong, random string in production (e.g., generated via `openssl rand -base64 32`)
JWT_SECRET="super-secret-jwt-key"

# 3. Server Configuration
PORT=5000
